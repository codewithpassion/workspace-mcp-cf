/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workspace-mcp-cf",
	"main": "src/server.ts",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": ["nodejs_compat"],
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 *
	 * Commands to set secrets:
	 * npx wrangler secret put CLERK_CLIENT_ID
	 * npx wrangler secret put CLERK_CLIENT_SECRET
	 * npx wrangler secret put CLERK_SECRET_KEY
	 * npx wrangler secret put CLERK_FRONTEND_API
	 * npx wrangler secret put COOKIE_ENCRYPTION_KEY
	 *
	 * Google Workspace secrets (new):
	 * npx wrangler secret put GOOGLE_CLIENT_ID
	 * npx wrangler secret put GOOGLE_CLIENT_SECRET
	 * npx wrangler secret put GOOGLE_TOKEN_ENCRYPTION_KEY
	 *   (generate with: openssl rand -hex 32)
	 *
	 */
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
	"kv_namespaces": [
		{
			// title: workspace-mcp-oauth-kv (account a12823016…)
			"binding": "OAUTH_KV",
			"id": "ec3bea4cb8004bb486b5eafa91b2ea06"
		},
		{
			// Google Workspace config + token storage (separate from OAUTH_KV).
			// title: workspace-mcp-ws-kv (account a12823016…)
			"binding": "WS_KV",
			"id": "d130dd427e794faa99dfb6b132931895"
		}
	],
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8788
	},
	"routes": [
		{
			"custom_domain": true,
			"pattern": "workspace-mcp.workbenchai.io"
		}
	]
}
